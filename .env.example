# Copy to `.env` and fill in real values. Never commit `.env`.
# Compose reads it automatically; every variable below has a dev default in
# compose.yaml so a fresh checkout still starts with `docker compose up -d`.

# App database (postgres:16-alpine, service `db`).
POSTGRES_PASSWORD=change-me-in-production
# Set to 0 to run the API with the in-memory store instead of Postgres.
USE_POSTGRES=1

# Recall database (pgvector/pg16, service `hindsight-db`).
HINDSIGHT_PASSWORD=change-me-in-production
# Recall service endpoint. Empty (or unreachable) falls back to local keyword recall.
HINDSIGHT_URL=http://hindsight:7680

# Hosted Meta Model API (tasks: language, voice transcribe, image, search grounding).
# No code reads this yet; provider wiring will use it verbatim.
META_API_KEY=
# Optional endpoint override. Official default (dev.meta.ai/docs): https://api.meta.ai/v1
META_API_BASE=https://api.meta.ai/v1
